---
import CatLayout from "../layouts/CatLayout.astro";
import FaqSection from "../components/FaqSection.astro";
import Callout from "../components/Callout.astro";
import CtaBlock from "../components/CtaBlock.astro";
import RelatedGuides from "../components/RelatedGuides.astro";
import DataTable from "../components/DataTable.astro";

const siteUrl = Astro.site || "https://adapthub.in/";

const faqs = [
  {
    question: "When is the CAT 2026 exam date?",
    answer: "CAT 2026 will be conducted on Sunday, November 29, 2026, as a computer-based test in three sessions across roughly 170 test cities, per the official CAT 2026 notification on iimcat.ac.in.",
  },
  {
    question: "Is the CAT 2026 notification out?",
    answer: "Yes. The official CAT 2026 notification was released in late July 2026 on iimcat.ac.in. Registration opened on August 3, 2026 (10:00 AM) and closes on September 15, 2026 (5:00 PM).",
  },
  {
    question: "What is the CAT 2026 registration fee?",
    answer: "₹2,700 for General, EWS, and NC-OBC candidates and ₹1,350 for SC, ST, and PwBD candidates, payable online at iimcat.ac.in during the application window.",
  },
  {
    question: "How many months are required to prepare for CAT 2026?",
    answer: "A dedicated preparation window of 3 to 8 months is ideal for CAT 2026. This allows sufficient time for concept building, adaptive practice, and intensive mock test analysis.",
  },
  {
    question: "What is the CAT 2026 eligibility criteria?",
    answer: "Per the CAT 2026 notification: a bachelor's degree with at least 50% marks (45% for SC/ST/PwD) or equivalent; final-year students can apply provisionally. There is no age limit and no attempt cap.",
  },
  {
    question: "Where do I register for CAT 2026?",
    answer: "Registration is online at iimcat.ac.in from August 3, 2026 (10:00 AM) to September 15, 2026 (5:00 PM). Keep photo, signature, and category certificates ready before applying.",
  },
];
---
<CatLayout
  title="CAT 2026 Exam Date: Nov 29 Official Timeline | AdaptHub"
  description="Official CAT 2026 exam date: Sunday, 29 November 2026. Registration 3 Aug – 15 Sep, admit card 4 Nov, fees, eligibility, and syllabus snapshot."
  ogType="article"
  datePublished="2025-11-01T00:00:00.000Z"
  dateModified="2026-08-08T00:00:00.000Z"
  breadcrumb={[
    { name: "Home", url: String(siteUrl) },
    { name: "CAT 2026 Exam Date", url: new URL("/cat-2026-exam-date", siteUrl).href },
  ]}
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "FAQPage",
        "@id": `${siteUrl}cat-2026-exam-date#faq`,
        "mainEntity": faqs.map((faq) => ({
          "@type": "Question",
          "name": faq.question,
          "acceptedAnswer": { "@type": "Answer", "text": faq.answer },
        })),
      },
    ],
  })} />
  <Callout label="CAT 2026 Snapshot">
    <p><strong>Exam date (official):</strong> Sunday, 29 November 2026, in three sessions across ~170 test cities (<a href="https://iimcat.ac.in" target="_blank" rel="noopener noreferrer" class="text-brand-teal hover:underline underline-offset-4">iimcat.ac.in</a>).</p>
    <p><strong>Registration:</strong> 3 August (10:00 AM) – 15 September 2026 (5:00 PM). Fee ₹2,700 (₹1,350 for SC/ST/PwBD).</p>
    <p><strong>Admit card:</strong> 4 November 2026.</p>
    <p><strong>Sections:</strong> VARC (24 Q), DILR (22 Q), QA (22 Q): 68 total, 204 marks, 120 min, +3/−1 MCQ, 0 penalty TITA.</p></Callout>

  <article>
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif tracking-tight mb-8 text-white">CAT 2026 Exam Date, Notification & Syllabus Snapshot</h1>
    <p class="text-zinc-400 text-lg md:text-xl leading-[1.8] mb-12">
      The CAT 2026 exam is <strong>officially scheduled for Sunday, 29 November 2026</strong>, per the CAT 2026 notification released in late July 2026 on <a href="https://iimcat.ac.in" target="_blank" rel="noopener noreferrer" class="text-brand-teal hover:underline underline-offset-4">iimcat.ac.in</a>. This page gives you the confirmed timeline, fees, eligibility, marking scheme, and a high-level syllabus so you can plan the final stretch.
    </p>

    <h2 class="text-2xl md:text-3xl font-serif text-white tracking-tight mt-16 mb-6">Key dates at a glance (official)</h2>
    <p data-speakable class="sr-only">
      CAT 2026 dates are official: the notification was released in late July 2026, registration runs 3 August to 15 September 2026, the admit card arrives 4 November, and the exam is Sunday 29 November 2026 in three sessions, with results expected around late December 2026 to early January 2027.
    </p>
    <DataTable
      headers={[
        { label: "Milestone", scope: "col" },
        { label: "Official date", scope: "col" },
        { label: "Action", scope: "col", class: "text-brand-teal" },
      ]}
      rows={[
        { cells: [{ content: "Official notification" }, { content: "Released late July 2026" }, { content: "Read bulletin on iimcat.ac.in" }] },
        { cells: [{ content: "Registration window" }, { content: "3 Aug (10 AM) – 15 Sep 2026 (5 PM)" }, { content: "Apply early; fee ₹2,700 / ₹1,350" }] },
        { cells: [{ content: "Admit card release" }, { content: "4 November 2026" }, { content: "Download + verify centre" }] },
        { cells: [{ content: "CAT 2026 exam" }, { content: "<strong>Sunday, 29 Nov 2026</strong> (3 sessions)" }, { content: "Exam day protocol ready" }] },
        { cells: [{ content: "Result declaration" }, { content: "Expected late Dec 2026 – early Jan 2027" }, { content: "Check percentile + apply" }] },
      ]}
    />

    <h2 class="text-2xl md:text-3xl font-serif text-white tracking-tight mt-16 mb-6">Eligibility (per the CAT 2026 notification)</h2>
    <p data-speakable class="sr-only">
      CAT eligibility needs a bachelor's degree with at least 50% marks, 45% for SC, ST, and PwD candidates, or an equivalent qualification. Final-year students can apply provisionally.
    </p>
    <ul class="list-disc pl-6 text-zinc-400 space-y-3 mb-10 leading-[1.75]">
      <li>Bachelor's degree with ≥50% marks (45% for SC/ST/PwD) or equivalent.</li><li>Final-year students eligible (provisional).</li>
      <li>No age limit, no attempt cap.</li>
      <li>Work experience not required.</li>
    </ul>

    <h2 class="text-2xl md:text-3xl font-serif text-white tracking-tight mt-16 mb-6">CAT 2026 exam pattern & marking</h2>
    <p data-speakable class="sr-only">
      CAT 2026 runs 120 minutes across three 40-minute sections: VARC 24 questions, DILR 22, QA 22, totalling 68 questions and 204 marks. Correct answers earn 3 marks, wrong MCQs lose 1, and TITA questions have no negative marking.
    </p>
    <ul class="list-disc pl-6 text-zinc-400 space-y-3 mb-10 leading-[1.75]">
      <li><strong>Sections:</strong> VARC (24 Q, 40 min), DILR (22 Q, 40 min), QA (22 Q, 40 min).</li>
      <li><strong>Total:</strong> 68 questions, 204 marks, 120 minutes (40 min/section, no switching).</li>
      <li><strong>Marking:</strong> +3 correct, −1 MCQ wrong, 0 penalty TITA.</li><li><strong>TITA share:</strong> Increasing trend; ~25–30% of questions are non-MCQ.</li>
    </ul>

    <h2 class="text-2xl md:text-3xl font-serif text-white tracking-tight mt-16 mb-6">High-level syllabus map</h2>
    <p data-speakable class="sr-only">
      The CAT syllabus spans three sections: VARC dominated by reading comprehension, DILR dominated by hybrid logic-data sets, and QA dominated by Arithmetic and Algebra. Full weightage sits on the CAT syllabus page.
    </p>
    <p class="text-zinc-400 leading-[1.8] mb-6">
      Full breakdown with weightage on the <a href="/cat-syllabus" class="text-brand-teal hover:underline underline-offset-4">CAT syllabus page</a>. Quick reference:
    </p>
    <ul class="list-disc pl-6 text-zinc-400 space-y-3 mb-10 leading-[1.75]">
      <li><strong>VARC (24 Q):</strong> RC (~16 Q), Para Jumbles, Summary, Odd-one-out, Para Completion.</li><li><strong>DILR (22 Q):</strong> Hybrid DI+LR sets, Games & Tournaments, Venn/Set Theory, Seating, Team Selection.</li><li><strong>QA (22 Q):</strong> Arithmetic ~35–50%, Algebra, Geometry/Mensuration, Number System, Modern Math (PnC/Prob).</li>
    </ul>

    <h2 class="text-2xl md:text-3xl font-serif text-white tracking-tight mt-16 mb-6">How to start today</h2>
    <p data-speakable class="sr-only">
      Start CAT 2026 prep now: register on iimcat.ac.in by 15 September 2026, take a cold diagnostic mock for a baseline, and begin daily adaptive practice so difficulty calibrates to you before 29 November.
    </p>
    <ol class="list-decimal pl-6 text-zinc-400 space-y-3 mb-10 leading-[1.75]">
      <li>Register at <a href="https://iimcat.ac.in" target="_blank" rel="noopener noreferrer" class="text-brand-teal hover:underline underline-offset-4">iimcat.ac.in</a> between 3 August and 15 September 2026 (fee ₹2,700; ₹1,350 for SC/ST/PwBD).</li>
      <li>Take a diagnostic mock to set your baseline (free on AdaptHub).</li><li>Pick a study plan: <a href="/cat-study-plan-2026" class="text-brand-teal hover:underline underline-offset-4">6-month standard</a> or <a href="/cat-preparation-without-coaching" class="text-brand-teal hover:underline underline-offset-4">compressed self-study</a>.</li><li>Start practicing on <a href="/pricing" class="text-brand-teal hover:underline underline-offset-4">AdaptHub</a>: it builds your daily focus from day 1.</li></ol>

    <CtaBlock text="Start practicing" />

    <FaqSection faqs={faqs} title="Frequently Asked Questions" />

    <RelatedGuides
      links={[
        { label: "CAT syllabus 2026", href: "/cat-syllabus" },
        { label: "CAT 2026 study plan", href: "/cat-study-plan-2026" },
        { label: "How to analyse mocks", href: "/cat-mock-analysis" },
        { label: "Self-study without coaching", href: "/cat-preparation-without-coaching" },
      ]}
    />
  </article>
</CatLayout>