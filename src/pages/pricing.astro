---
import CatLayout from "../layouts/CatLayout.astro";
import FaqSection from "../components/FaqSection.astro";
import SpotlightButton from "../components/SpotlightButton";
import { resolvedContent as CONTENT } from "../utils/config";

const faqs = CONTENT.pricing.faqs;
const features = CONTENT.pricing.features;

const siteUrl = Astro.site || "https://adapthub.in/";
---
<CatLayout
  title={CONTENT.metadata.pricing.title}
  description={CONTENT.metadata.pricing.description}
  maxWidth="max-w-[1800px]"
  head={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "FAQPage",
        "@id": `${siteUrl}pricing#faq`,
        "mainEntity": faqs.map(faq => ({
          "@type": "Question", "name": faq.question, "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
        }))
      }
    ]
  })}
>
  <div class="container mx-auto px-4 sm:px-6 md:px-12 lg:px-24 max-w-[1800px]">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-8 items-center">
      
      {/* Left: Typographic Anchor */}
      <div class="lg:col-span-6 xl:col-span-5 relative z-20">

        <h1 class="text-[2.75rem] sm:text-5xl md:text-6xl lg:text-7xl font-serif text-fg tracking-tight leading-none mb-6 page-stagger" style="--i:1">
          Free CAT preparation — <br class="hidden lg:block"/>
          <span class="italic text-brand-teal relative inline-block pb-2 tracking-normal mt-2">
            ₹0 for aspirants.
            <svg class="absolute -bottom-2 left-0 w-full h-[3px] text-brand-teal/70" viewBox="0 0 100 3" preserveAspectRatio="none"><path d="M0 1.5 Q 50 4.5 100 1.5" stroke="currentColor" stroke-width="2" fill="none"/></svg>
          </span>
        </h1>
        
        <p data-speakable class="speakable-content text-fg font-sans text-base md:text-lg leading-[1.75] max-w-lg mb-4 tracking-wide page-stagger" style="--i:2">
          AdaptHub is currently free CAT preparation: adaptive study plans, AI hints and explanations, and analytics at ₹0 with no credit card required. The core engine stays free for individual aspirants—no trial cliff.
        </p>
        <p class="text-fg-muted font-sans text-base md:text-lg leading-[1.75] max-w-lg mb-10 tracking-wide page-stagger" style="--i:2">
          Quality education is a baseline, not a privilege. Start free practice and use the full adaptive system unrestricted.
        </p>

        <div class="page-stagger" style="--i:3">
          <SpotlightButton 
            client:load
            href={CONTENT.links.app}
            target="_blank"
            rel="noopener noreferrer"
            className="relative overflow-hidden w-auto px-8 sm:px-10 py-4 sm:py-5 bg-accent-yellow text-black font-bold text-sm md:text-base rounded-full shadow-cta-gold hover:shadow-cta-gold-hover flex items-center justify-center gap-3 transition-all duration-500 touch-manipulation whitespace-nowrap inline-flex group"
          >
            <span class="relative z-10 flex items-center gap-2 tracking-wide">
              Start free practice
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform duration-400 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </SpotlightButton>
        </div>
      </div>

      {/* Right: The Holographic Access Artifact */}
      <div class="lg:col-start-7 lg:col-span-6 xl:col-start-7 xl:col-span-6 relative perspective-container page-stagger" style="--i:4">
        
        {/* Ambient Glow */}
        <div class="absolute inset-0 bg-brand-teal/10 blur-[100px] rounded-full mix-blend-screen z-0 pointer-events-none" aria-hidden="true"></div>

        {/* 3D Rotated Card */}
        <div class="access-card relative z-10 w-full max-w-[500px] mx-auto bg-surface/40 backdrop-blur-xl border border-border-subtle rounded-3xl p-8 shadow-2xl overflow-hidden group">
          
          {/* Hardware Corner Brackets */}
          <div class="absolute top-0 left-0 w-8 h-8 border-t border-l border-brand-teal/30 rounded-tl-3xl pointer-events-none" aria-hidden="true"></div>
          <div class="absolute bottom-0 right-0 w-8 h-8 border-b border-r border-brand-teal/30 rounded-br-3xl pointer-events-none" aria-hidden="true"></div>

          {/* Card Header */}
          <div class="flex justify-between items-start mb-12 border-b border-border-subtle pb-6">
            <span class="font-mono text-[10px] text-fg-muted uppercase tracking-widest">Free Access</span>
          </div>

          {/* The Telemetry Readout */}
          <div class="text-center relative py-4">
            <div class="absolute inset-0 bg-[linear-gradient(90deg,transparent_0%,rgb(var(--brand-teal-rgb)/0.05)_50%,transparent_100%)] pointer-events-none"></div>
            <div class="flex items-start justify-center text-fg select-none">
              <span class="text-3xl md:text-5xl font-sans font-light text-fg-subtle mt-2 mr-1">₹</span>
              <span class="text-[6rem] md:text-[9rem] font-serif leading-[0.8] tracking-tighter drop-shadow-[0_0_30px_rgb(var(--brand-teal-rgb)/0.2)]">0</span>
            </div>
            <span class="block font-mono text-xs text-fg-muted uppercase tracking-[0.3em] mt-6">Cost / Platform Access</span>
          </div>

        </div>
      </div>

    </div>
  </div>

  {/* ── System Modules (Grid) ── */}
  <section class="relative z-10 w-full border-t border-border-subtle bg-surface/20 mt-24">
    <div class="container mx-auto px-4 sm:px-6 md:px-12 lg:px-24 py-24 max-w-[1800px]">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16 page-stagger" style="--i:5">
        <div>
          <h2 class="font-serif text-3xl md:text-4xl text-fg tracking-tight mb-3">Everything Included at ₹0</h2>
          <p class="text-fg-muted font-sans text-base tracking-wide">All features unlocked. No upgrade required.</p>
        </div>
        <span class="font-mono text-[10px] text-brand-teal uppercase tracking-[0.2em] px-3 py-1 border border-brand-teal/20 bg-brand-teal/5">6 Features</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
        {features.map((feature, index) => (
          <div class="group relative bg-surface/40 border border-border-subtle p-6 md:p-8 hover:bg-white/[0.04] hover:border-brand-teal/30 transition-all duration-500 page-stagger overflow-hidden" style={`--i:${6 + index}`}>
            {/* Hover Glow */}
            <div class="absolute inset-0 bg-gradient-to-br from-brand-teal/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" aria-hidden="true"></div>
            
            <div class="flex justify-between items-start mb-12 relative z-10">
              <span class="font-mono text-[10px] text-fg-subtle group-hover:text-brand-teal transition-colors duration-300 tracking-[0.2em]">{feature.id}</span>
              <span class="w-1.5 h-1.5 bg-zinc-700 group-hover:bg-brand-teal rounded-full transition-colors duration-500 shadow-[0_0_0_rgb(var(--brand-teal-rgb)/0)] group-hover:shadow-[0_0_10px_rgb(var(--brand-teal-rgb)/0.8)]"></span>
            </div>
            <h3 class="text-lg md:text-xl font-sans text-fg group-hover:text-fg font-medium transition-colors duration-300 relative z-10 leading-snug">
              {feature.name}
            </h3>
          </div>
        ))}
      </div>

    </div>
  </section>

  <nav aria-label="Related CAT prep guides" class="container mx-auto px-4 sm:px-6 md:px-12 lg:px-24 max-w-[1800px] py-12 border-t border-border-subtle">
    <p class="font-mono text-[10px] text-fg-subtle uppercase tracking-[0.2em] mb-4">Related guides</p>
    <ul class="flex flex-wrap gap-x-6 gap-y-3 text-sm text-fg-muted">
      <li><a href="/adaptive-learning-cat" class="hover:text-brand-teal underline underline-offset-4 decoration-white/10">What is adaptive learning for CAT?</a></li>
      <li><a href="/cat-study-plan-2026" class="hover:text-brand-teal underline underline-offset-4 decoration-white/10">CAT 2026 study plan</a></li>
      <li><a href="/cat-mock-analysis" class="hover:text-brand-teal underline underline-offset-4 decoration-white/10">How to analyse CAT mocks</a></li>
      <li><a href="/how-to-score-99-percentile-cat" class="hover:text-brand-teal underline underline-offset-4 decoration-white/10">99 percentile blueprint</a></li>
      <li><a href="/cat-preparation-without-coaching" class="hover:text-brand-teal underline underline-offset-4 decoration-white/10">Prepare without coaching</a></li>
    </ul>
  </nav>

  <FaqSection faqs={faqs} title="Common Questions" />
</CatLayout>

<style>
  /* ── Holographic Access Artifact (3D CSS) ── */
  .perspective-container {
    perspective: 1200px;
  }

  .access-card {
    transform: none;
    transform-style: flat;
    animation: none;
    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.3),
      inset 0 0 0 1px rgba(255, 255, 255, 0.05);
  }

  /* ── Native Details/Summary Fixes ── */
  details > summary::-webkit-details-marker {
    display: none;
  }

  /* ── Hardware Guardrails ── */

  @media (prefers-reduced-motion: reduce) {
    .access-card { animation: none; }
    .animate-ping { animation: none; opacity: 0; }
  }
</style>