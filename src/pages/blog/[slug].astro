---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar";
import AnnouncementBar from "../../components/AnnouncementBar";
import Footer from "../../components/Footer.astro";
import EditorialByline from "../../components/EditorialByline.astro";
import ArticleHeroImage from "../../components/ArticleHeroImage.astro";
import ArticleSources from "../../components/ArticleSources.astro";
import { BLOG_ARTICLES } from "../../constants/blog-data";
import {
  absoluteArticleImages,
  buildEditorialAuthor,
  getArticleEditorial,
} from "../../constants/editorial";
import { buildPublisher } from "../../utils/schema";

export function getStaticPaths() {
  return BLOG_ARTICLES.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const siteUrl = Astro.site ? String(Astro.site) : "https://adapthub.in/";
const editorial =
  article.editorial ?? getArticleEditorial("blog", article.slug, article.title, article.date);
const canonicalURL = new URL(`/blog/${article.slug}`, siteUrl).href;
const pageTitle = article.seoTitle ?? `${article.title} | AdaptHub`;

const hubBySlug: Record<string, { href: string; label: string }> = {
  "varc-fact-vs-judgment": { href: "/cat-varc-strategy", label: "CAT VARC Strategy 2026" },
  "decoding-2025-dilr-trap-sets": { href: "/cat-dilr-strategy", label: "CAT DILR Strategy 2026" },
  "zone-of-proximal-development-cat-algebra": { href: "/cat-quant-strategy", label: "CAT Quant Strategy 2026" },
  "metacognition-first-cat-skill": { href: "/how-to-score-99-percentile-cat", label: "99 Percentile CAT Blueprint" },
  "distractor-error-taxonomy": { href: "/cat-mock-analysis", label: "How to Analyse CAT Mocks" },
  "quality-streaks-vs-raw-study-hours": { href: "/cat-study-plan-2026", label: "CAT 2026 Study Plan" },
};
const pillarHub = hubBySlug[article.slug];
---

<Layout
  title={pageTitle}
  description={article.excerpt}
  datePublished={editorial.datePublished}
  dateModified={editorial.dateModified}
  ogType="article"
  articleSection={article.category}
  articleAuthor="AdaptHub Editorial"
  ogImage={new URL(editorial.images.sixteenByNine.url, siteUrl).href}
  ogImageAlt={editorial.images.sixteenByNine.alt}
  ogImageWidth={editorial.images.sixteenByNine.width}
  ogImageHeight={editorial.images.sixteenByNine.height}
  ogImageType={editorial.images.sixteenByNine.mimeType}
  breadcrumb={[
    { name: "Home", url: siteUrl },
    { name: "Blog", url: new URL("/blog", siteUrl).href },
    { name: article.title, url: canonicalURL },
  ]}
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": article.title,
    "description": article.excerpt,
    "datePublished": editorial.datePublished,
    "dateModified": editorial.dateModified,
    "inLanguage": "en-IN",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": canonicalURL,
    },
    "image": absoluteArticleImages(editorial.images, siteUrl),
    "author": buildEditorialAuthor(siteUrl),
    "publisher": buildPublisher(siteUrl),
    ...(article.sources && article.sources.length > 0 ? { "citation": article.sources.map((source) => source.url) } : {}),
    "isAccessibleForFree": true,
    "url": canonicalURL,
  })} />

  <AnnouncementBar client:idle transition:persist />
  <Navbar client:load transition:persist />

  <main id="main-content" class="relative isolate pt-32 md:pt-40 pb-32 overflow-x-clip min-h-[100svh] bg-bg selection:bg-[rgb(252,211,77,0.3)]">

    <div class="background-pulse" aria-hidden="true"></div>

    {/* Film Grain */}
    <svg class="absolute inset-0 w-full h-full pointer-events-none z-[1] opacity-[0.03]" aria-hidden="true">
      <filter id="article-grain">
        <feTurbulence type="fractalNoise" baseFrequency="0.75" numOctaves="4" stitchTiles="stitch" />
        <feColorMatrix type="saturate" values="0" />
      </filter>
      <rect width="100%" height="100%" filter="url(#article-grain)" />
    </svg>

    {/* Header radial glow */}
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-3xl h-[400px] bg-brand-teal/[0.04] blur-[100px] rounded-full pointer-events-none" aria-hidden="true"></div>

    <div class="container mx-auto px-4 sm:px-6 md:px-12 lg:px-24 relative z-10 max-w-[1800px] mt-12 md:mt-20">

      {/* Back Link */}
      <a
        href="/blog"
        class="inline-flex items-center gap-3 font-mono text-[10px] text-fg-muted uppercase tracking-[0.25em] hover:text-brand-teal transition-colors duration-300 mb-16 group"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 transform group-hover:-translate-x-0.5 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 5 5 12 12 19"></polyline>
        </svg>
         CAT Prep Blog
      </a>

      {/* 12-Col Layout */}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24 items-start">

        {/* Article */}
        <article class="lg:col-span-8 xl:col-span-7">

          {/* Header */}
          <header class="mb-16 md:mb-20">
            <div class="flex items-center gap-4 mb-8">
              <span class="font-mono text-[9px] text-brand-teal uppercase tracking-[0.25em] bg-brand-teal/5 border border-brand-teal/20 px-2 py-0.5">
                {article.category}
              </span>
              <span class="font-mono text-[9px] text-fg-subtle uppercase tracking-[0.2em]">{editorial.datePublished.slice(0, 10)}</span>
              <span class="font-mono text-[9px] text-zinc-700 uppercase tracking-[0.2em] border-l border-border pl-4">
                EST: {article.readTime}
              </span>
            </div>

            <h1 class="text-[2.5rem] sm:text-5xl md:text-6xl font-serif text-fg tracking-tighter leading-none mb-8 text-balance">
              {article.title}
            </h1>

            <p class="text-fg-muted font-sans text-lg md:text-xl leading-[1.7] max-w-[60ch] tracking-wide border-l-2 border-brand-teal/40 pl-6 mb-7">
              {article.excerpt}
            </p>
            <EditorialByline
              datePublished={editorial.datePublished}
              dateModified={editorial.dateModified}
              reviewState={editorial.reviewState}
            />
          </header>

          <ArticleHeroImage images={editorial.images} eager class="mb-16" />

          {/* Divider */}
          <div class="flex items-center gap-4 mb-16">
            <div class="h-px bg-surface/40 flex-1"></div>
            <span class="font-mono text-[9px] text-zinc-700 uppercase tracking-[0.25em]">[ TRANSMISSION ]</span>
            <div class="h-px bg-surface/40 flex-1"></div>
          </div>

          {/* Body */}
          <div class="space-y-16 md:space-y-20">
            {article.body.map((section) => (
              <section class="article-section">
                {section.heading && (
                  <h2 class="text-2xl md:text-3xl font-serif text-fg tracking-tight leading-snug mb-8 relative pl-6">
                    <span class="absolute left-0 top-[0.35em] w-2 h-2 bg-brand-teal/50" aria-hidden="true"></span>
                    {section.heading}
                  </h2>
                )}
                <div class="space-y-6 md:space-y-8">
                  {section.paragraphs.map((para) => (
                    <p
                      class="text-fg font-sans text-base md:text-[1.125rem] leading-[1.85] tracking-wide max-w-[65ch]"
                      set:html={para}
                    ></p>
                  ))}
                </div>
              </section>
            ))}
          </div>

          <ArticleSources
            sources={article.sources}
            methodology="This article distinguishes external evidence from AdaptHub's editorial recommendations and illustrative product examples."
          />

          {pillarHub && (
            <div class="mt-16 p-6 border border-brand-teal/20 bg-brand-teal/[0.03]">
              <p class="font-mono text-[10px] text-brand-teal uppercase tracking-[0.2em] mb-3">[ Strategy Hub ]</p>
              <p class="text-fg-muted text-sm md:text-base leading-relaxed mb-4">
                Continue with the full pillar guide this article supports.
              </p>
              <a
                href={pillarHub.href}
                class="inline-flex items-center gap-2 font-serif text-lg text-fg hover:text-brand-teal transition-colors"
              >
                {pillarHub.label}
                <span class="text-brand-teal" aria-hidden="true">→</span>
              </a>
            </div>
          )}

          {/* Footer rule */}
          <div class="mt-20 pt-12 border-t border-border flex items-center justify-between">
            <a
              href="/blog"
              class="inline-flex items-center gap-3 font-mono text-[10px] text-fg-muted uppercase tracking-[0.25em] hover:text-brand-teal transition-colors duration-300 group"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 transform group-hover:-translate-x-0.5 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 5 5 12 12 19"></polyline>
              </svg>
              All Articles
            </a>
            <a
              href="https://app.adapthub.in"
              class="inline-flex items-center gap-3 font-mono text-[10px] text-brand-teal uppercase tracking-[0.25em] hover:text-fg transition-colors duration-300 group"
            >
              Start practicing
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </a>
          </div>
        </article>

        {/* Sidebar */}
        <aside class="lg:col-span-4 xl:col-start-9 xl:col-span-4 mt-0 lg:mt-0">
          <div class="lg:sticky lg:top-40 space-y-12">

            {/* More Articles */}
            <div>
              <div class="mb-6">
                <span class="font-mono text-[10px] text-fg-muted uppercase tracking-[0.2em]">[ More Signals ]</span>
              </div>
              <div class="flex flex-col gap-1 border border-border-subtle p-[1px] relative">
                <div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-brand-teal/40 pointer-events-none" aria-hidden="true"></div>
                <div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-brand-teal/40 pointer-events-none" aria-hidden="true"></div>
                {BLOG_ARTICLES.filter((a) => a.slug !== article.slug).slice(0, 4).map((related) => (
                  <a
                    href={`/blog/${related.slug}`}
                    class="group block bg-bg px-6 py-6 hover:bg-surface/40 transition-colors duration-300 border-b border-border-subtle last:border-0 relative overflow-hidden"
                  >
                    <div class="absolute left-0 top-0 bottom-0 w-[2px] bg-brand-teal scale-y-0 group-hover:scale-y-100 transition-transform duration-400 origin-top pointer-events-none" aria-hidden="true"></div>
                    <span class="font-mono text-[9px] text-brand-teal uppercase tracking-[0.2em] block mb-2">{related.category}</span>
                    <span class="font-sans text-sm text-fg group-hover:text-fg leading-snug tracking-tight transition-colors duration-300">
                      {related.title}
                    </span>
                  </a>
                ))}
              </div>
            </div>

            {/* CTA */}
            <div class="border border-border-subtle bg-surface/20 p-8 relative">
              <div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-brand-teal/40 pointer-events-none" aria-hidden="true"></div>
              <div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-brand-teal/40 pointer-events-none" aria-hidden="true"></div>
              <span class="font-mono text-[9px] text-brand-teal uppercase tracking-[0.2em] block mb-4">[ Practice ]</span>
              <p class="font-sans text-sm text-fg-muted leading-relaxed mb-6">
                Apply these principles inside the AdaptHub engine. A 15-minute diagnostic maps your baseline, then adaptive practice keeps you in the zone.
              </p>
              <a
                href="https://app.adapthub.in"
                class="inline-flex items-center gap-3 font-mono text-[10px] text-fg uppercase tracking-[0.2em] hover:text-brand-teal transition-colors duration-300 group"
              >
                Start practicing
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </a>
            </div>

          </div>
        </aside>

      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  main :global(strong) {
    color: white;
    font-weight: 500;
    border-bottom: 1px solid rgb(var(--brand-teal-rgb) / 0.35);
    padding-bottom: 1px;
  }
  main :global(em) {
    color: rgba(161, 161, 170, 0.9);
    font-style: italic;
  }

  @media (prefers-reduced-motion: reduce) {
    .article-section * { transition: none !important; }
  }
</style>
