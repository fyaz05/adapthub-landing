---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import AnnouncementBar from "../components/AnnouncementBar";
import Footer from "../components/Footer.astro";
import EditorialByline from "../components/EditorialByline.astro";
import ArticleHeroImage from "../components/ArticleHeroImage.astro";
import {
  absoluteArticleImages,
  buildEditorialAuthor,
  getArticleEditorial,
} from "../constants/editorial";
import { buildPublisher } from "../utils/schema";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  datePublished?: string;
  dateModified?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  articleSlug?: string;
  breadcrumb?: { name: string; url: string }[];
  head?: string;
  /** Max-width utility for the content wrapper. Defaults to `max-w-4xl`
   *  (article reading width). Wide/landing pages (e.g. pricing,
   *  cat-syllabus) should pass `max-w-[1800px]`. */
  maxWidth?: string;
}

const {
  title,
  description,
  noindex = false,
  datePublished,
  dateModified,
  ogType = "website",
  ogImage,
  articleSlug,
  breadcrumb,
  head,
  maxWidth = "max-w-4xl",
} = Astro.props;

// TechArticle (subtype of Article) auto-emitted when ogType="article" + datePublished.
// IMPORTANT: pages emitting their own TechArticle/BlogPosting via `head` should
// use Layout directly — CatLayout would produce a duplicate Article schema.
const siteUrl = Astro.site || "https://adapthub.in/";
// String(siteUrl) preserves the trailing slash, matching Layout.astro's @id form.
const siteUrlStr = String(siteUrl);
// Mirror Layout.astro's path normalization (strip .html + trailing slash) so TechArticle @id matches Layout's WebPage @id.
const rawPath = Astro.url.pathname;
const normalizedPath = rawPath === "/index.html" ? "/" : rawPath.replace(/\.html$/, "");
const cleanPath = normalizedPath.replace(/\/$/, "") || "/";
const articleURL = new URL(cleanPath, siteUrl).href;
const resolvedArticleSlug = articleSlug || cleanPath.replace(/^\//, "");
const editorial =
  ogType === "article"
    ? getArticleEditorial("cat", resolvedArticleSlug, title, datePublished)
    : null;
// Gate on `!head` so pages passing their own Article via `head` don't get a duplicate.
const articleSchema =
  ogType === "article" && datePublished && !head
    ? JSON.stringify({
        "@context": "https://schema.org",
        "@type": "TechArticle",
        "@id": `${articleURL}#techarticle`,
        "headline": title,
        "description": description,
        "datePublished": editorial?.datePublished || datePublished,
        "dateModified": editorial?.dateModified || dateModified || datePublished,
        "inLanguage": "en-IN",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": articleURL,
        },
        "image": editorial
          ? absoluteArticleImages(editorial.images, siteUrlStr)
          : [ogImage || new URL("/og-image.png", siteUrl).href],
        "author": buildEditorialAuthor(siteUrlStr),
        "publisher": buildPublisher(siteUrlStr),
        "isAccessibleForFree": true,
        "url": articleURL,
      })
    : null;

---

<Layout
  title={title}
  description={description}
  noindex={noindex}
  datePublished={datePublished}
  dateModified={dateModified}
  ogType={ogType}
  ogImage={editorial ? new URL(editorial.images.sixteenByNine.url, siteUrl).href : ogImage}
  ogImageAlt={editorial?.images.sixteenByNine.alt}
  ogImageWidth={editorial?.images.sixteenByNine.width}
  ogImageHeight={editorial?.images.sixteenByNine.height}
  ogImageType={editorial?.images.sixteenByNine.mimeType}
  articleAuthor={editorial ? "AdaptHub Editorial" : undefined}
  breadcrumb={breadcrumb}
>
  <slot name="head" />
  {articleSchema && <script type="application/ld+json" is:inline slot="head" set:html={articleSchema} />}
  {head && <script type="application/ld+json" is:inline slot="head" set:html={head} />}
  <AnnouncementBar client:idle transition:persist />
  <Navbar client:load transition:persist />

  <main id="main-content" class="relative isolate pt-32 md:pt-40 pb-32 overflow-x-clip min-h-[100svh] bg-bg selection:bg-[rgba(252,211,77,0.3)]">
    <div class="background-pulse" aria-hidden="true">
      <slot name="grain" />
    </div>
    <div class={`mx-auto w-full px-4 sm:px-6 md:px-12 lg:px-24 relative z-10 ${maxWidth} mt-8`}>
      {editorial && (
        <aside class="mb-10 space-y-6" aria-label="Article publication details">
          <EditorialByline
            datePublished={editorial.datePublished}
            dateModified={editorial.dateModified}
            reviewState={editorial.reviewState}
          />
          <ArticleHeroImage images={editorial.images} eager />
        </aside>
      )}
      <slot />
    </div>
  </main>
  <Footer />
</Layout>

<style>
  @media (prefers-reduced-motion: reduce) {
    .background-pulse { animation: none !important; }
    ::slotted([slot="grain"]) { opacity: 0 !important; }
  }
</style>
