---
interface Source {
  label: string;
  url: string;
}

interface Props {
  sources?: Source[];
  methodology?: string;
}

const { sources = [], methodology } = Astro.props;
---

{(sources.length > 0 || methodology) && (
  <section class="article-section" aria-labelledby="article-sources-heading">
    <h2 id="article-sources-heading" class="text-2xl md:text-3xl font-serif text-white tracking-tight leading-snug mb-6">
      Sources and methodology
    </h2>
    {methodology && <p class="mb-5 max-w-[65ch] text-zinc-300 leading-relaxed">{methodology}</p>}
    {sources.length > 0 && (
      <ul class="space-y-3 max-w-[65ch]">
        {sources.map((source) => (
          <li>
            <a
              href={source.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-zinc-300 hover:text-white underline decoration-zinc-700 hover:decoration-brand-teal underline-offset-4"
            >
              {source.label}
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
)}
