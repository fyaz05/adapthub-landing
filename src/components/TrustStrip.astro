---
import { resolvedContent as CONTENT } from "../utils/config";

const { questions, free, sections } = CONTENT.trustStrip;
---

<section aria-label="Platform trust indicators" class="w-full pt-8 mt-10 sm:mt-12 border-t border-white/[0.06] flex items-center justify-center relative z-20">
  <div class="relative inline-flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-6 py-2.5 px-6 sm:px-8 rounded-2xl sm:rounded-full bg-white/[0.03] backdrop-blur-xl border border-white/[0.08] shadow-[0_8px_32px_rgba(0,0,0,0.5),inset_0_1px_0_rgba(255,255,255,0.06)]">
    
    {/* 10,000+ Curated Questions */}
    <div class="flex items-center gap-2.5">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-teal opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-teal"></span>
      </span>
      <span class="font-serif text-sm sm:text-base font-medium tracking-tight text-white">
        {questions}
      </span>
    </div>

    <span class="hidden sm:block h-3.5 w-px bg-white/15" aria-hidden="true"></span>

    {/* Free Status Badge */}
    <div class="inline-flex items-center gap-2 px-3 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
      <span class="font-mono text-[11px] uppercase tracking-widest font-medium">
        {free}
      </span>
    </div>

    <span class="hidden sm:block h-3.5 w-px bg-white/15" aria-hidden="true"></span>

    {/* Section Coverage Pills */}
    <div class="flex items-center gap-1.5 font-mono text-[11px] tracking-wider">
      {
        sections.split(" · ").map((section, i) => (
          <Fragment>
            {i > 0 && <span class="text-zinc-600 font-light">·</span>}
            <span class="px-2 py-0.5 rounded bg-white/[0.04] border border-white/[0.08] text-zinc-300 font-semibold shadow-xs">
              {section}
            </span>
          </Fragment>
        ))
      }
    </div>

  </div>
</section>
