---
import { resolvedContent as CONTENT } from "../utils/config";

const { questions, free, sections } = CONTENT.trustStrip;
---

<section
  class="relative py-8 md:py-10 bg-bg overflow-hidden border-b border-border-subtle"
  aria-label="Platform trust indicators"
>
  <div class="container mx-auto px-4 sm:px-6 md:px-12 lg:px-24 max-w-[1800px] relative z-10">
    <div class="flex flex-wrap items-center justify-center gap-x-12 gap-y-4 text-center">
      <div class="flex items-center gap-3">
        <span class="font-serif text-2xl md:text-3xl text-fg font-medium tracking-tight">
          {questions}
        </span>
        <span class="hidden sm:block w-px h-6 bg-border-subtle" aria-hidden="true"></span>
      </div>
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
          <span class="font-mono text-[11px] text-emerald-400 uppercase tracking-widest">
            {free}
          </span>
        </span>
        <span class="hidden sm:block w-px h-6 bg-border-subtle" aria-hidden="true"></span>
      </div>
      <span class="font-mono text-sm text-fg-muted uppercase tracking-[0.15em]">
        {sections}
      </span>
    </div>
  </div>
</section>
