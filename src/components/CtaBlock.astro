---
interface Props {
  text: string;
  href?: string;
  variant?: 'default' | 'yellow';
}

const { text, href = '/pricing', variant = 'default' } = Astro.props;

const baseClasses = 'inline-flex items-center gap-3 px-8 py-4 font-bold uppercase tracking-wider text-sm transition-all';
// DELIBERATE CROSS-SURFACE DIFFERENCE — do not "sync" `yellow` to teal.
// Gold is landing's conversion accent: it reads because every ambient surface
// here (grid, spotlights, card flashlight) is cool teal, so warm-vs-cool
// separation makes the CTA pop. The app has no teal-CTA counterpart to match —
// its default button is neutral charcoal/cream (btn-primary) and teal is
// reserved there for in-app next-action affordances, not marketing CTAs.
const variants = {
  default: 'bg-white text-black hover:bg-zinc-200',
  yellow: 'bg-accent-yellow text-black hover:bg-yellow-400 active:scale-95 shadow-cta-gold hover:shadow-cta-gold-hover',
};
---

<div class="mt-16 text-center border-t border-white/10 pt-16">
  <a 
    href={href}
    class={`group ${baseClasses} ${variants[variant]} justify-center touch-manipulation whitespace-nowrap`}
  >
    {text}
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h14"/>
      <path d="m12 5 7 7-7 7"/>
    </svg>
  </a>
</div>