# Auto detect text files and perform LF normalization
* text=auto

# Explicitly check out text files with LF endings.
# `text=auto` alone only normalizes on COMMIT — on checkout it defers to
# core.autocrlf, which is `true` on Windows and yields CRLF working copies.
# biome.json sets formatter.lineEnding "lf", so a CRLF checkout makes
# `bun run lint` permanently red on Windows for files nobody has touched.
# Mirrors the app repo's .gitattributes so both surfaces behave identically.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.astro text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
bun.lock text eol=lf

# Files that should NOT have their line endings modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.avif binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
