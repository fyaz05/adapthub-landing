{
  "name": "adapthub-landing-page",
  "version": "1.0.0",
  "private": true,
  "description": "High-performance adaptive learning interface for competitive examinations.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "astro dev",
    "partytown": "node node_modules/@qwik.dev/partytown/bin/partytown.cjs copylib public/~partytown",
    "prebuild": "bun run test:color-contract && bun run check:color-contract && bun run partytown",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "biome check",
    "gen:skills": "bun run scripts/gen-skills.ts",
    "format": "biome format --write",
    "type-check": "astro check",
    "pages:deploy": "bun run build && node node_modules/wrangler/bin/wrangler.js pages deploy dist --project-name adapthub --branch main",
    "check:color-contract": "bun run scripts/check-color-contract.ts",
    "test:color-contract": "bun test scripts/check-color-contract.test.ts"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/dancing-script": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@qwik.dev/partytown": "^0.14.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.4",
    "motion": "^12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "2.5.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "picomatch": "2.3.2",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "wrangler": "^4.114.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "ajv": "8.20.0",
    "fast-uri": "3.1.4",
    "js-yaml": "4.3.0",
    "sharp": "0.35.2",
    "smol-toml": "1.7.1"
  }
}
